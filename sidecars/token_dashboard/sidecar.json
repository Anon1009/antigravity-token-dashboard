{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "Token Dashboard",
  "description": "Live AI telemetry dashboard in the side pane: tok/s output speed, cache hit rate, conversation token totals, and context window usage.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Token Dashboard",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Token Dashboard"
      }
    ]
  }
}
